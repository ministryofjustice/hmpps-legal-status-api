{
  "dev": {
    "legal_status_base_url": "https://legal-status-api-dev.hmpps.service.justice.gov.uk",
    "ras_base_url": "https://remand-and-sentencing-api-dev.hmpps.service.justice.gov.uk",
    "manage_offences_base_url": "https://manage-offences-api-dev.hmpps.service.justice.gov.uk",
    "prisoner_search_base_url": "https://prisoner-search-dev.prison.service.justice.gov.uk",
    "Security": {
      "Auth": {
        "Prisoner Search API": {
          "Type": "OAuth2",
          "Grant Type": "Client Credentials",
          "Client Credentials": "basic",
          "Token URL": "https://sign-in-dev.hmpps.service.justice.gov.uk/auth/oauth/token",
          "Client ID": "{{prisoner-search-api.clientId}}",
          "Client Secret": "{{prisoner-search-api.clientSecret}}"
        },
        "Manage Offences API": {
          "Type": "OAuth2",
          "Grant Type": "Client Credentials",
          "Client Credentials": "basic",
          "Token URL": "https://sign-in-dev.hmpps.service.justice.gov.uk/auth/oauth/token",
          "Client ID": "{{manage-offences-api.clientId}}",
          "Client Secret": "{{manage-offences-api.clientSecret}}"
        },
        "Remand and Sentencing API": {
          "Type": "OAuth2",
          "Grant Type": "Client Credentials",
          "Client Credentials": "basic",
          "Token URL": "https://sign-in-dev.hmpps.service.justice.gov.uk/auth/oauth/token",
          "Client ID": "{{manage-offences-api.clientId}}",
          "Client Secret": "{{manage-offences-api.clientSecret}}"
        },
        "Legal Status API": {
          "Type": "OAuth2",
          "Grant Type": "Client Credentials",
          "Client Credentials": "basic",
          "Token URL": "https://sign-in-dev.hmpps.service.justice.gov.uk/auth/oauth/token",
          "Client ID": "{{manage-offences-api.clientId}}",
          "Client Secret": "{{manage-offences-api.clientSecret}}"
        }
      }
    }
  }
}